# Linear (https://linear.app/settings/account/security)
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxx

# Slug Linear : la partie après /project/ dans l'URL (ex: jarvis-180d65a2c767).
# Le hash est obligatoire — c'est ce qui identifie le projet, le préfixe est optionnel
# mais on le garde par convention pour rester lisible.
LINEAR_PROJECT_SLUG=jarvis-XXXXXXXXXXXX

# Repo source cloné par Symphony dans chaque worktree
SOURCE_REPO_URL=https://github.com/Ph3niXx/jarvis-cockpit.git

# Workspace local (un sous-dossier par issue Linear)
WORKSPACE_ROOT=./workspaces

# Orchestrator
POLL_INTERVAL_SECONDS=60
MAX_CONCURRENT_AGENTS=2
MAX_TURNS=25
LOG_LEVEL=info

# Dashboard — port distinct de program-board (3000) et atlas (3001)
DASHBOARD_PORT=3002

# GitHub auto-merge (état Linear "Merging")
GITHUB_MERGE_MODE=squash
GITHUB_DELETE_BRANCH_AFTER_MERGE=true

# Cloudflare Pages — désactivé (jarvis-cockpit est servi par GitHub Pages, pas Cloudflare)
# CLOUDFLARE_PROJECT_NAME=
# CLOUDFLARE_ACCOUNT_SUBDOMAIN=
# CLOUDFLARE_PAGE_PATH=/
